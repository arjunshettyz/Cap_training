@model IEnumerable<admission_form.Models.AdmissionModel>
@{ ViewData["Title"] = "All Students"; }

<!-- Page header -->
<div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
        <h1 class="text-4xl font-bold text-white mb-1">All Students</h1>
        <p class="text-blue-100 text-sm">@Model.Count() student(s) registered in the system</p>
    </div>
    <a asp-action="Index" class="btn-primary inline-flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
        New Application
    </a>
</div>

@if (!Model.Any())
{
    <div class="card p-16 text-center">
        <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"/></svg>
        <p class="text-gray-600 text-lg font-semibold">No applications yet</p>
        <p class="text-gray-500 text-sm mt-1 mb-4">Start adding students to see them listed here</p>
        <a asp-action="Index" class="btn-primary">Add First Student</a>
    </div>
}
else
{
    <div class="card overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b border-gray-200" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                        <th class="text-left text-xs font-semibold text-white uppercase tracking-wider px-6 py-4">#</th>
                        <th class="text-left text-xs font-semibold text-white uppercase tracking-wider px-4 py-4">Photo</th>
                        <th class="text-left text-xs font-semibold text-white uppercase tracking-wider px-4 py-4">Name</th>
                        <th class="text-left text-xs font-semibold text-white uppercase tracking-wider px-4 py-4">Age</th>
                        <th class="text-left text-xs font-semibold text-white uppercase tracking-wider px-4 py-4">Email</th>
                        <th class="text-left text-xs font-semibold text-white uppercase tracking-wider px-4 py-4">Phone</th>
                        <th class="text-left text-xs font-semibold text-white uppercase tracking-wider px-4 py-4">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-gray-50 transition">
                            <td class="px-6 py-4 text-gray-700 font-mono font-semibold text-xs">@item.Id</td>
                            <td class="px-4 py-4">
                                @if (item.ProfileImage != null && item.ProfileImage.Length > 0)
                                {
                                    <img src="data:@item.ImageContentType;base64,@Convert.ToBase64String(item.ProfileImage)"
                                         alt="@item.Name"
                                         class="w-10 h-10 object-cover rounded-full ring-2 ring-blue-200 shadow" />
                                }
                                else
                                {
                                    <div class="w-10 h-10 rounded-full flex items-center justify-center bg-gray-200">
                                        <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>
                                    </div>
                                }
                            </td>
                            <td class="px-4 py-4 font-semibold text-gray-800">@item.Name</td>
                            <td class="px-4 py-4 text-gray-600">@item.Age</td>
                            <td class="px-4 py-4 text-gray-600 text-xs">@(item.Email ?? "—")</td>
                            <td class="px-4 py-4 text-gray-600">@item.PhoneNumber</td>
                            <td class="px-4 py-4">
                                <div class="flex items-center gap-3">
                                    <a asp-action="Edit" asp-route-id="@item.Id"
                                       class="inline-flex items-center gap-1 text-blue-600 hover:text-blue-700 font-medium transition text-xs">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm-9.477 12.977l-.677 2.262a.75.75 0 00.9.9l2.262-.677m0 0a5.25 5.25 0 1110.606-2.147m-1.44-2.653m0 0a5.247 5.247 0 00-1.519-1.834l-.54.54a3.75 3.75 0 001.518 1.838z"/></svg>
                                        Edit
                                    </a>
                                    <a asp-action="IdCard" asp-route-id="@item.Id" target="_blank"
                                       class="inline-flex items-center gap-1 text-green-600 hover:text-green-700 font-medium transition text-xs">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H5a2 2 0 00-2 2v10a2 2 0 002 2h5m0 0h5a2 2 0 002-2v-10a2 2 0 00-2-2h-5m0 0V5a2 2 0 012-2h3.28a1 1 0 00.948-.684l1.498-4.493a1 1 0 00-.502-1.21l-.306-.102A1 1 0 0014.973 1M7 10l.293 9.707a1 1 0 001.414 0l.293-.707M7 10l3-3m0 0l3 3m-6 3v6a1 1 0 001 1h2a1 1 0 001-1v-6"/></svg>
                                        ID Card
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id"
                                       class="inline-flex items-center gap-1 text-red-600 hover:text-red-700 font-medium transition text-xs">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
