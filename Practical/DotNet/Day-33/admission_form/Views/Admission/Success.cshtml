@{ ViewData["Title"] = "Application Submitted"; }

<div class="max-w-lg mx-auto text-center py-20">
    <!-- Success icon -->
    <div class="w-24 h-24 rounded-full bg-gradient-to-br from-green-400 to-green-500 flex items-center justify-center mx-auto mb-8 shadow-lg">
        <svg class="w-12 h-12 text-white" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
    </div>

    <h1 class="text-4xl font-bold text-white mb-4">Application Submitted!</h1>
    <p class="text-blue-100 text-lg mb-8 leading-relaxed">Your admission application has been successfully recorded. Our team will review your application and contact you shortly with next steps.</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <a asp-action="Index" class="btn-primary inline-flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
            Submit Another
        </a>
        <a asp-action="List" class="bg-white hover:bg-gray-50 text-gray-700 font-semibold px-6 py-3 rounded-lg transition text-sm inline-flex items-center justify-center gap-2 shadow-sm">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" clip-rule="evenodd"/></svg>
            View All Students
        </a>
    </div>
</div>
