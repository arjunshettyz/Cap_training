@model admission_form.Models.AdmissionModel
@{ ViewData["Title"] = "Delete Admission"; }

<div class="mb-8 flex items-center gap-4">
    <a asp-action="List" class="p-2 rounded-lg hover:bg-blue-100 transition text-gray-600 hover:text-blue-600" title="Back">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
    </a>
    <h1 class="text-4xl font-bold text-white">Delete Application</h1>
</div>

<div class="max-w-lg">
    <!-- Warning banner -->
    <div class="flex items-start gap-4 bg-red-50 border-l-4 border-red-500 rounded-lg px-5 py-4 mb-6">
        <svg class="w-6 h-6 text-red-500 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
        <div>
            <p class="text-sm font-bold text-red-700">Warning: This action cannot be undone</p>
            <p class="text-sm text-red-600 mt-1">All student records and associated data will be permanently removed from the system.</p>
        </div>
    </div>

    <!-- Student card -->
    <div class="card p-6 mb-6">
        <div class="flex items-center gap-4 mb-5">
            @if (Model.ProfileImage != null)
            {
                <img src="@Url.Action("GetImage", new { id = Model.Id })" alt="@Model.Name"
                     class="w-16 h-16 object-cover rounded-full ring-2 ring-red-300" />
            }
            else
            {
                <div class="w-16 h-16 rounded-full bg-gray-200 flex items-center justify-center">
                    <svg class="w-7 h-7 text-gray-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>
                </div>
            }
            <div>
                <p class="font-bold text-gray-800 text-lg">@Model.Name</p>
                <p class="text-sm text-gray-500">Student ID: #@Model.Id</p>
            </div>
        </div>
        <dl class="grid grid-cols-2 gap-x-6 gap-y-3 text-sm border-t border-gray-200 pt-4">
            <div>
                <dt class="text-gray-500 font-medium mb-1">Age</dt>
                <dd class="text-gray-800 font-semibold">@(Model.Age?.ToString() ?? "—")</dd>
            </div>
            <div>
                <dt class="text-gray-500 font-medium mb-1">Phone</dt>
                <dd class="text-gray-800 font-semibold">@Model.PhoneNumber</dd>
            </div>
            <div class="col-span-2">
                <dt class="text-gray-500 font-medium mb-1">Email</dt>
                <dd class="text-gray-800 font-semibold">@(Model.Email ?? "—")</dd>
            </div>
        </dl>
    </div>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="flex items-center gap-4">
        <button type="submit" class="bg-red-600 hover:bg-red-700 text-white font-semibold px-6 py-3 rounded-lg shadow-sm transition text-sm">
            Yes, Delete Permanently
        </button>
        <a asp-action="List" class="text-sm text-gray-600 hover:text-gray-800 transition">Cancel</a>
    </form>
</div>
